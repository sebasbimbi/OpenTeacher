# Copia este archivo a .env.local y rellena con tus llaves reales.
# .env.local NUNCA se commitea al repo.

# Anthropic Claude API. Se obtiene en https://console.anthropic.com/
# Sin esta llave, OpenEd corre en modo MOCK (respuestas pre-generadas, sin red).
ANTHROPIC_API_KEY=

# Llave del proveedor de transcripcion. Hoy OpenAI; sirve igual la de Groq.
OPENAI_API_KEY=

# Proveedor de transcripcion, por configuracion y no por codigo.
# Default: OpenAI. Para Groq (capa gratuita, whisper-large-v3-turbo rinde
# mejor en espanol): https://api.groq.com/openai/v1 y whisper-large-v3-turbo
TRANSCRIPCION_BASE_URL=
TRANSCRIPCION_MODELO=

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Forzar modo mock aunque haya API key (demo offline o ahorrar tokens).
# Valores: "true" | "false". Default: true si no hay ANTHROPIC_API_KEY.
OPENED_MOCK_MODE=
